<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include standard app database and preferences -->
        <include domain="database" path="tactical_legend.db" />
        <include domain="sharedpref" path="." />
        <!-- Exclude temporary caches and sensitive keystore data -->
        <exclude domain="root" path="no_backup" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="tactical_legend.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="root" path="no_backup" />
    </device-transfer>
</data-extraction-rules>
